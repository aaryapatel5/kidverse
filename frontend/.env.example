# KidVerse Frontend Environment Configuration Template
# Copy this file to '.env' or set these variables in your deployment hosting dashboard (e.g. Vercel, Netlify, Render).
# Do not commit your live '.env' with production secrets.

# Backend Spring Boot REST API Base URL (with trailing /api)
# Local development default: http://localhost:8080/api
# Production example: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:8080/api
